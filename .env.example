# Copia este archivo a .env y ajusta los valores: cp .env.example .env
# El archivo .env NO se sube a Git (esta en .gitignore).

# Puerto HTTP en el que escucha el servidor.
PUERTO=:8080

# Archivo SQLite de la base de datos.
RUTA_DB=for-neos-api.db

# Backend: "gorm" (por defecto) o "sqlc".
STORAGE=gorm

# Clave para firmar los JWT. EN PRODUCCION usa un valor largo y secreto.
JWT_SECRETO=for-neos-secreto-solo-dev

# Validez del token (formato de duracion de Go: 24h, 30m, 1h30m...).
JWT_DURACION=24h

# Timeouts del servidor HTTP.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s